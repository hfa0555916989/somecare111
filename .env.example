# كلمة مرور لوحة التحكم (مطلوبة)
ADMIN_PASSWORD=غيّرها-لكلمة-قوية
# نص عشوائي طويل لتأمين الجلسة (اختياري لكن مفضّل)
AUTH_SECRET=اكتب-اي-نص-عشوائي-طويل
# تُضاف تلقائياً عند ربط Upstash Redis و Vercel Blob من Vercel:
# KV_REST_API_URL / KV_REST_API_TOKEN  (أو UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN)
# BLOB_READ_WRITE_TOKEN
# بعد ما يفتح hassandev.sa فعلاً: تحويل الدومين القديم somecare.shop إليه (301)
# REDIRECT_OLD_DOMAIN=1
# Cloudflare Turnstile للتحقق في نموذج «تواصل معنا» (يعمل فقط عند وجود المفتاحين)
# TURNSTILE_SITE_KEY=0x4AAAAAAA...
# TURNSTILE_SECRET_KEY=0x4AAAAAAA...
# مفتاح Claude لاستيراد عروض الأسعار من ملفات PDF في لوحة التحكم (اختياري)
# ANTHROPIC_API_KEY=sk-ant-...
# التخزين الخاص للعقود والفواتير (Blob بنوع Private، وعند الربط اكتب البادئة PRIVATE_BLOB)
# PRIVATE_BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# مفتاح تشفير مفاتيح المشاريع (.env) — نص عشوائي طويل، أضفه قبل حفظ أول مشروع ولا تغيّره
# VAULT_KEY=...
# إشعارات الإيميل عبر Resend (بعد توثيق النطاق في resend.com)
# RESEND_API_KEY=re_...
# MAIL_FROM=المطوّر حسن <noreply@hassandev.sa>
# المحادثة الصوتية (ElevenLabs)
# ELEVENLABS_API_KEY=...
# ELEVENLABS_VOICE_ID=  (اختياري، ويمكن اختياره من إعدادات المساعد)
